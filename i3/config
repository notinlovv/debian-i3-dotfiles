set $mod Mod4
font pango:JetBrains Mono 11

# Compositor, pantalla y fondo
exec_always --no-startup-id "killall picom; picom -b --config ~/.config/picom/picom.conf"
exec --no-startup-id xrandr --output HDMI-A-0 --mode 1920x1080 --rate 100
exec_always --no-startup-id feh --bg-fill ~/Pictures/wallpaper.jpeg

# Bloqueo y portales XDG
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id /usr/libexec/xdg-desktop-portal-gtk
exec --no-startup-id /usr/libexec/xdg-desktop-portal

# Aplicaciones y utilidades
bindsym $mod+Return exec alacritty
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+f exec pcmanfm
bindsym $mod+Shift+x exec --no-startup-id i3lock -c 1a1b26
bindsym $mod+Shift+s exec --no-startup-id maim -s | xclip -selection clipboard -t image/png

# Gestión de ventanas
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m '¿Seguro que deseas salir de i3wm?' -B 'Sí, salir' 'i3-msg exit'"

# Audio
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Flotantes
floating_modifier $mod
tiling_drag modifier titlebar
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Workspaces (1-5)
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# Modo redimensionar
mode "resize" {
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Estética minimalista (sin barra, sin gaps, sin bordes)
gaps inner 0
gaps outer 0
default_border pixel 0
default_floating_border pixel 0

# Colores Gruvbox: class / border / background / text / indicator / child_border
client.focused          #d79921 #282828 #ebdbb2 #d65d0e #d79921
client.focused_inactive #3c3836 #282828 #a89984 #3c3836 #3c3836
client.unfocused        #1d2021 #282828 #928374 #1d2021 #1d2021
client.urgent           #cc241d #cc241d #ebdbb2 #cc241d #cc241d
client.placeholder      #282828 #282828 #ebdbb2 #282828 #282828
client.background       #282828
